{
  "name": "hr-portal-functions",
  "version": "1.0.0",
  "description": "Firebase Cloud Functions for HR Portal",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "googleapis": "^169.0.0",
    "node-fetch": "^2.7.0",
    "stripe": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "private": true
}
