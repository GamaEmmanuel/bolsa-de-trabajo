rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Each user can read/write their own user document
    // Also allow public read access to user documents that have company data (for job postings)
    match /users/{userId} {
      allow read: if isOwner(userId) || (resource != null && 'companyData' in resource.data);
      allow update, delete: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    // Saved searches belong to a user (ownerId)
    match /saved-searches/{id} {
      allow read, update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    // Public jobs listing: only published jobs are readable by anyone; no client writes
    match /jobs/{jobId} {
      allow read: if resource.data.status == 'published';
      allow write: if false;
    }

    // Job postings collection (for backward compatibility with existing code)
    match /jobPostings/{jobId} {
      allow read: if true; // All job postings are public to read
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.createdByUserId == request.auth.uid;
    }

    // Job applications: candidates can access their own applications, companies can access applications for their job postings
    match /applications/{applicationId} {
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.candidateId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.candidateId == request.auth.uid;
    }

    // Job offers: companies can manage offers for their applications, candidates can read their own offers
    match /offers/{offerId} {
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.companyId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.companyId == request.auth.uid;
    }

    // Interviews: companies can manage interviews for their applications, candidates can read their own interviews
    match /interviews/{interviewId} {
      allow read: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.companyId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.candidateId == request.auth.uid ||
        resource.data.companyId == request.auth.uid
      );
      allow delete: if isSignedIn() && resource.data.companyId == request.auth.uid;
    }

    // Candidate profiles: candidates can manage their own profiles, companies can read all profiles for talent search
    match /candidateProfiles/{profileId} {
      allow read: if isSignedIn(); // Companies and candidates can read profiles for talent search
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User accounts: users can manage their own account settings, but signed-in users (companies) can read others for talent search
    match /userAccounts/{userId} {
      allow read: if isSignedIn(); // Allow all signed-in users to read user accounts (for talent search)
      allow write: if isSignedIn() && request.auth.uid == userId; // Only owner can write
    }

    // Companies: users can read any company data for job listings
    // Company admins can update their own company, including subscription data
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        // Allow if user is updating their own company
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId == companyId) ||
        // Allow if companyId matches the user's UID (for 1:1 relationship)
        companyId == request.auth.uid
      );
      allow delete: if false; // Prevent deletion
    }

    // Subscriptions: read-only access for company admins, no client writes (only via webhooks)
    match /subscriptions/{subscriptionId} {
      // Allow company admins to read their own subscription
      allow read: if isSignedIn() && resource.data.companyId in [
        request.auth.uid,
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId
      ];
      // No client writes - only server via webhooks
      allow write: if false;
    }

    // Conversations: users can access conversations where they are a participant
    match /conversations/{conversationId} {
      // Allow reading if user is in the participants array
      allow read, list: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn() && (
        request.auth.uid in request.resource.data.participants
      );
      // Allow update if user is participant (for archiving, unread counts, etc.)
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );
      allow delete: if false; // Don't allow deleting conversations
    }

    // Messages: users can access messages in conversations where they are sender or receiver
    match /messages/{messageId} {
      // Allow reading single messages if user is sender or receiver
      allow get: if isSignedIn() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      // Allow querying messages (Firestore will auto-filter based on get rules)
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      // Allow update for marking as read (by receiver) or editing/deleting (by sender)
      allow update: if isSignedIn() && (
        // Receiver can mark as read
        (resource.data.receiverId == request.auth.uid && request.resource.data.read == true) ||
        // Sender can edit or soft-delete their own messages
        (resource.data.senderId == request.auth.uid)
      );
      allow delete: if false; // Don't allow hard deleting messages
    }

    // Email logs: Allow authenticated users to write logs
    match /emailLogs/{logId} {
      allow create: if isSignedIn();
      allow read: if false; // Logs are write-only for privacy
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
